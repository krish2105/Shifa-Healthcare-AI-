# ==============================================================================
# Shifa42 backend configuration
#
# Copy to `.env` and fill in. `.env` is gitignored; this file is committed.
#
# The system runs with NONE of these set — see "Degraded mode" in the README.
# The LLM falls back to a deterministic stub and the vector store to a local
# NumPy index. Every response is then flagged `degraded: true` and the UI shows a
# banner. That path exists so the repo is runnable by anyone who clones it; it is
# not a path that may produce a number reported in RESULTS.md.
# ==============================================================================

# ---- LLM provider -------------------------------------------------------------
# At least one is required for real inference. Resolution order is the order below;
# additional providers act as failover when the first hits a rate limit, which is
# the failure mode that actually bites on free tiers.

# https://console.groq.com/keys  — free, fastest inference
GROQ_API_KEY=

# https://aistudio.google.com/apikey — free tier, higher daily quota than Groq
GEMINI_API_KEY=

# https://cloud.cerebras.ai — free tier
CEREBRAS_API_KEY=

# ---- Vector store -------------------------------------------------------------
# Neon/Supabase/local Postgres with the pgvector extension.
# Use the POOLED connection string (host contains "-pooler").
# Leave blank to use the local NumPy store instead — see app/retrieval/store.py.
DATABASE_URL=

# ---- App ----------------------------------------------------------------------
APP_ENV=local
LOG_LEVEL=INFO

# Comma-separated. Never "*" — this API streams clinical content.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

RATE_LIMIT=30/minute

# ---- Retrieval tuning ---------------------------------------------------------
RETRIEVAL_TOP_K=12
RETRIEVAL_CANDIDATE_K=40
RRF_K=60
MMR_LAMBDA=0.6

# ---- Safety gate --------------------------------------------------------------
# The governance parameter. Below this faithfulness score an answer is reformulated
# and retried, then escalated to a physician. RESULTS.md reports how this trades
# off against the escalation rate.
GROUNDEDNESS_THRESHOLD=0.75
MAX_REFORMULATIONS=2

# ---- Corpus -------------------------------------------------------------------
GUIDELINE_DOC_LIMIT=2000
MIN_GUIDELINE_CHARS=1200

# ---- Embeddings ---------------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_DEVICE=auto
EMBEDDING_BATCH_SIZE=128
EMBEDDING_FP16=true
