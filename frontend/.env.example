# Base URL of the Shifa42 FastAPI backend.
#
# NEXT_PUBLIC_* values are inlined into the client bundle at build time, so this
# must be set before `npm run build` — changing it afterwards has no effect until
# a rebuild.
#
# Local:      http://127.0.0.1:8000
# Deployed:   https://shifa42-backend.onrender.com
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
